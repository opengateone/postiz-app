# Copy to .env on the server (chmod 600). Never commit .env.

# --- Image (pin a tag built by CI; roll back by setting the previous one) ---
POSTIZ_IMAGE=ghcr.io/opengateone/postiz-app:og-latest
POSTIZ_PORT=4007
# 127.0.0.1 behind an HTTPS proxy; 0.0.0.0 only to test on http://<ip>:4007
POSTIZ_BIND=127.0.0.1
# Only while testing over plain HTTP (cookies without the Secure flag). Postiz checks presence, not value:
# NOT_SECURED=false still means insecure mode (and breaks logout), so leave it out behind HTTPS.
# NOT_SECURED=true

# --- Public URLs (HTTPS, behind the reverse proxy) ---
MAIN_URL=https://post.example.com
FRONTEND_URL=https://post.example.com
NEXT_PUBLIC_BACKEND_URL=https://post.example.com/api

# --- Secrets: generate with `openssl rand -hex 32` ---
JWT_SECRET=
POSTGRES_USER=postiz
POSTGRES_PASSWORD=
POSTGRES_DB=postiz
TEMPORAL_DB_PASSWORD=

# --- Accounts ---
# Create the first admin account, then set to true.
DISABLE_REGISTRATION=false
# One workspace for everybody: no new workspace after the first; a Google sign-in from a Settings > Team invite
# (sent to that email) joins only the inviting workspace. Accounts made in /m/accounts work as before.
# OG_SINGLE_WORKSPACE=true
# RESEND_API_KEY=
# EMAIL_FROM_ADDRESS=
# EMAIL_FROM_NAME=

# --- Storage: local (default) or cloudflare (R2). TikTok needs media on a public HTTPS domain. ---
STORAGE_PROVIDER=local
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_ACCESS_KEY=
# CLOUDFLARE_SECRET_ACCESS_KEY=
# CLOUDFLARE_BUCKETNAME=
# CLOUDFLARE_BUCKET_URL=
# CLOUDFLARE_REGION=auto

# --- Public API ---
API_LIMIT=90

# --- Social apps (fill only the channels you use; callback URLs in the Postiz docs) ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
X_API_KEY=
X_API_SECRET=

# --- AI (optional) ---
OPENAI_API_KEY=

NX_ADD_PLUGINS=false
